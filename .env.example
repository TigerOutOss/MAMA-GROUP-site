# Chaîne de connexion PostgreSQL (Supabase : Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:motdepasse@db.xxxxx.supabase.co:5432/postgres

# Chaîne aléatoire longue, sert à signer les sessions admin — n'importe quelle valeur secrète et unique
JWT_SECRET=change_moi_pour_une_longue_chaine_aleatoire

# Généré avec : node hash-password.js "votre_mot_de_passe"
ADMIN_PASSWORD_HASH=
